{
  "name": "nuxthub-starter",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "deploy-cloudflare": "NITRO_PRESET=cloudflare_module pnpm build && pnpm wrangler deploy && pnpm wrangler d1 migrations apply DB --remote",
    "deploy-vercel": "pnpm vercel deploy",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "prepare": "husky",
    "db:generate": "nuxt db generate",
    "db:migrate": "nuxt db migrate"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.127",
    "@iconify-json/simple-icons": "^1.2.94",
    "@libsql/client": "^0.17.4",
    "@lichess-org/chessground": "^10.1.1",
    "@nuxt/content": "^3.16.0",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/seo": "^5.3.14",
    "@pinia/colada": "^1.4.2",
    "@pinia/colada-nuxt": "^1.0.2",
    "@pinia/nuxt": "^1.0.2",
    "@upstash/redis": "^1.38.3",
    "@vercel/blob": "^2.8.0",
    "chess.js": "^1.4.0",
    "dayjs": "^1.11.23",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "nuxt-auth-utils": "^0.5.30",
    "pinia": "^4.0.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/vscode-icons": "^1.2.76",
    "@nuxt/devtools": "4.0.0-alpha.12",
    "@nuxt/eslint-config": "^1.17.0",
    "baseline-browser-mapping": "^2.11.20",
    "eslint": "^10.9.1",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "satori": "^0.33.4",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.127.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi",
      "workerd"
    ]
  },
  "lint-staged": {
    "*": "pnpm lint"
  }
}
